generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum DogStatus {
  active
  claim_pending
  resolved
  expired
}

enum ListingType {
  found
  lost
}

enum HoldingStatus {
  holding
  still_loose
  taken_to_shelter
}

enum DogSize {
  small
  medium
  large
}

model Dog {
  id             String        @id @default(cuid())
  listingType    ListingType   @default(found)
  status         DogStatus     @default(active)
  dogName        String?
  photoUrl       String
  foundLat       Float
  foundLng       Float
  foundLocation  String
  // Canonical 209 city name (src/lib/cities.ts), derived server-side from
  // the geocoder hint or nearest-centroid on the coordinates. Nullable only
  // for rows that predate the field (backfilled by scripts/backfill-city.ts).
  city           String?
  foundDate      DateTime
  breedGuess     String?
  size           DogSize?
  color          String?
  hasCollar      Boolean       @default(false)
  collarTagInfo  String?
  temperament    String?
  holdingStatus  HoldingStatus @default(holding)
  notes          String?
  finderEmail    String
  manageToken    String        @unique
  createdAt      DateTime      @default(now())
  expiresAt      DateTime
  resolvedAt     DateTime?

  claims         Claim[]

  @@index([status])
  @@index([listingType])
  @@index([city])
}

enum ClaimStatus {
  new
  finder_contacted
  rejected
}

model Claim {
  id              String      @id @default(cuid())
  dogId           String
  dog             Dog         @relation(fields: [dogId], references: [id], onDelete: Cascade)
  claimantName    String
  claimantContact String
  proofAnswer     String
  status          ClaimStatus @default(new)
  createdAt       DateTime    @default(now())

  @@index([dogId])
}

model Subscriber {
  id               String   @id @default(cuid())
  email            String   @unique
  // Double opt-in: alerts only go out once confirmed is true (the recipient
  // clicked the link in the confirmation email), so entering a stranger's
  // email doesn't immediately subscribe them.
  confirmed        Boolean  @default(false)
  confirmToken     String   @unique
  unsubscribeToken String   @unique
  // Canonical city names (src/lib/cities.ts) this subscriber wants alerts
  // for. Empty = all cities — also the default for subscribers who signed
  // up before per-city preferences existed.
  cities           String[] @default([])
  createdAt        DateTime @default(now())
}

model DevEmail {
  id        String   @id @default(cuid())
  to        String
  subject   String
  body      String
  createdAt DateTime @default(now())
}

// Backs isRateLimited() in src/lib/rateLimit.ts. A DB-backed sliding window
// (rather than an in-memory Map) is required because Vercel serverless
// functions are multi-instance and short-lived — an in-memory counter
// resets on every cold start and isn't shared across concurrent instances.
model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}
